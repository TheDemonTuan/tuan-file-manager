# ====================================================================
# Self-Hosted File Manager - Production Configuration Contract
# ====================================================================

# Application Environment (production | development | test)
APP_ENV=production
APP_LISTEN_ADDR=:8080

# Hostnames for Dual Host Ingress
# files.yourdomain.com -> Admin UI (protected by Cloudflare Access)
# share.yourdomain.com -> Public Anonymous Downloads
APP_ADMIN_HOST=files.yourdomain.com
APP_SHARE_HOST=share.yourdomain.com

# Physical Storage Paths
FILEMGR_DATA_DIR=/srv/filemgr/data
FILEMGR_BIND_ADDR=127.0.0.1:8080
DATA_DIR=/data
DB_PATH=/data/db/app.db
DB_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS=NORMAL

# Storage Quotas & Limits
MAX_STORAGE_BYTES=536870912000     # 500 GiB
MAX_FILE_BYTES=10737418240         # 10 GiB
MIN_FREE_BYTES=5368709120          # 5 GiB physical free guard
TRASH_RETENTION_DAYS=30
MAX_NODE_COUNT_SOFT=500000

# Tus Resumable Upload Settings
TUS_CHUNK_SIZE=16777216            # 16 MiB (safely below Cloudflare 100MB limit)
MAX_ACTIVE_UPLOADS=4
MAX_ACTIVE_DOWNLOADS=8
MAX_PUBLIC_DOWNLOADS=4
UPLOAD_EXPIRY_HOURS=24

# Cloudflare Zero Trust Access (Admin Protection)
# DEV_AUTH_BYPASS must be false in production!
DEV_AUTH_BYPASS=false
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-application-audience-tag-from-cloudflare-access
CF_ACCESS_ALLOWED_SUBJECT=admin@yourdomain.com
TRUSTED_PROXY_MODE=cloudflare

# Public Share Cryptography
# Generate secure 64-char random strings using: openssl rand -hex 32
SHARE_TOKEN_PEPPER=replace_with_a_long_random_secret_token_pepper_32_bytes
SHARE_SESSION_SECRET=replace_with_a_long_random_session_secret_32_bytes
GLOBAL_SHARE_EPOCH=1

# Cloudflare R2 / Restic Off-site Backup Credentials
# Notice: These credentials are used ONLY by the backup container, NOT by the web app!
BACKUP_ENABLED=true
RESTIC_REPOSITORY=s3:https://<cloudflare-account-id>.r2.cloudflarestorage.com/filemgr-backups
RESTIC_PASSWORD=replace_with_strong_restic_encryption_password
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
